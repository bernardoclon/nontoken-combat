<form class="nontoken-combat-form">
  <div class="form-group">
    <label for="nontoken-combat-target">Combate</label>
    <select id="nontoken-combat-target" name="combatId">
      {{#each combats as |combat|}}
        <option value="{{combat.id}}" {{#if combat.selected}}selected{{/if}}>{{combat.label}}</option>
      {{/each}}
      <option value="new" {{#if createNewCombat}}selected{{/if}}>Crear un combate nuevo</option>
    </select>
  </div>

  <div class="form-group nontoken-combat-search-row">
    <label for="nontoken-combat-search">Buscar actor</label>
    <input id="nontoken-combat-search" name="actorSearch" type="search" placeholder="Nombre del personaje…" autocomplete="off">
  </div>

  <div class="nontoken-combat-list" role="group" aria-label="Actores disponibles">
    {{#each actors as |actor|}}
      <label class="nontoken-combat-actor" data-actor-name="{{actor.searchName}}">
        <input type="checkbox" name="actorIds" value="{{actor.id}}">
        <img src="{{actor.img}}" alt="" loading="lazy">
        <span class="nontoken-combat-actor-name">{{actor.name}}</span>
        <span class="nontoken-combat-actor-type">{{actor.type}}</span>
      </label>
    {{else}}
      <p class="nontoken-combat-empty">No hay actores que puedas gestionar.</p>
    {{/each}}
  </div>

  <footer class="nontoken-combat-footer">
    <button type="button" data-action="toggleAll">
      <i class="fa-solid fa-check-double" aria-hidden="true"></i>
      Seleccionar todos
    </button>
    <button type="button" class="nontoken-combat-submit" data-action="addSelected">
      <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
      Añadir seleccionados
    </button>
  </footer>
</form>
